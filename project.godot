; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Placeholder Scenes"
run/main_scene="res://Environments/Day.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://project-icon.png"

[audio]

buses/default_bus_layout=""

[display]

window/stretch/scale=0.5

[input]

jump={
"deadzone": 0.5,
"events": Array[InputEvent]([Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
])
}

[input_devices]

virtual_controller/ios/enable_controller=true
virtual_controller/ios/enable_right_thumbstick=false
virtual_controller/ios/enable_button_b=false
virtual_controller/ios/enable_button_x=false
virtual_controller/ios/enable_button_y=false

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.626816, 0.961838, 1, 1)

[xogot]

project/editorState=[{
"column": 0,
"current": true,
"line": 4,
"path": "res://scripts/player.gd",
"type": "file"
}]
project/breakpoints={}
